InputGood[6]=vegetables
InputCapacity[6]=100 
InputFactor[6]=31
InputGood[7]=canned_food
InputCapacity[7]=75 
InputFactor[7]=20
pier_sub_1_mask=0x01
pier_sub_2_mask=0x01
passenger_boost=800
mail_boost=200
electricity_amount=1
electricity_boost=1000

copyright=WLindley
dims=1,1,4

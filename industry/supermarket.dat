class_proportion_jobs[4]=2
intro_year=1950
intro_month=9
retire_year=1975
retire_month=2
distributionweight=9
Location=City
climates=rocky,tundra,temperate,mediterran,desert,arctic,tropic
Productivity=7
Range=10
MapColor=135
InputGood[0]=meat
InputCapacity[0]=100
InputFactor[0]=16 

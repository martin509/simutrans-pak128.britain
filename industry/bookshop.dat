# Source: http://www.cambridge.org/gb/academic/subjects/history/economic-history/british-economic-growth-12701870?format=PB
# Broadberry, Stephen, Bruce M.S. Campbell, Alexander Klein, Mark Overton and Bas van Leeuwen (2015), British Economic Growth, 1270-1870, Cambridge: Cambridge University Press
# This gives figures for the British bookbinding industry from 1270-1870 in relative values to 1700.
# Assuming British book consumption in much of the 19th century is ~equal to book production, this shows book consumption relatively flat 1750-1800 and then rising steeply 1800-1860.
# We'll split this into either 1820 or before (in which case Bookshop1750 is relevant) or after 1820 (in which case Bookshop1860 is relevant)
# Bookshop1750: Median population-adjusted relative book consumption 1750-1820, from the dataset, is ~67
# Bookshop1860: Median pop-adjusted relative consumption 1820-1870, is ~180
# Therefore: there should be at least 2.64x as much book consumption for Bookshop1860 vs Bookshop1750.
# Adjusted distribution_weight for Bookshop1860 is therefore 5 instead of 4, and adjust consumption down slightly to 5 instead of 6.
#
# TODO: 
# Get realistic values for Bookshop1920, Bookshop1950, Bookshop1970.
# Bookshop1970 seems a bit high in consumption.
# Also consider adding an intermediate Bookshop1820, since it's a 110 year gap between Bookshop industries, to smooth out the overall increase.

Obj=factory
name=Bookshop1750
copyright=James
intro_year=1750
intro_month=1
retire_year=1860
retire_month=1
population_and_visitor_demand_capacity=75
employment_capacity=22
mail_demand=8
class_proportion[0]=0
class_proportion[1]=10
class_proportion[2]=30
class_proportion[3]=30
class_proportion[4]=30
class_proportion_jobs[0]=40
class_proportion_jobs[1]=45
class_proportion_jobs[2]=15
class_proportion_jobs[3]=0
class_proportion_jobs[4]=0
climates=rocky,tundra,temperate,mediterran,desert,arctic,tropic
Location=city
distributionweight=2
Productivity=4  
Range=3  
MapColor=7
InputGood[0]=Bucher
InputCapacity[0]=17 
InputFactor[0]=100  
#InputSupplier[0]=1
needs_ground=1
Dims=1,1,4
BackImage[2][0][0][0][0][0]=bookshop.0.0
BackImage[1][0][0][0][0][0]=bookshop.0.1
BackImage[0][0][0][0][0][0]=bookshop.0.2
BackImage[3][0][0][0][0][0]=bookshop.0.3
BackImage[2][0][0][0][0][1]=bookshop.1.0
BackImage[1][0][0][0][0][1]=bookshop.1.1
BackImage[0][0][0][0][0][1]=bookshop.1.2
BackImage[3][0][0][0][0][1]=bookshop.1.3

upgrade[0]=Bookshop1860
upgrade[1]=Bookshop1920
